# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/calytrix?schema=public"

# Random secret used to HMAC-sign the short-lived "Connect GitHub" OAuth state
# (src/lib/oauth-state.ts). Generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth App credentials (github.com/settings/developers), used by the
# separate "Connect GitHub" flow (src/lib/github-oauth.ts) — not for identity.
# Callback URL must be: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Tilvar API key (self-hosted model, see athena.org.tr)
TILVAR_API_KEY=""

# Max characters of prompt sent to Tilvar per review request (diff gets truncated to fit)
TILVAR_API_MAX_CHARS=40000

# Required in production; the canonical URL of the deployed app. Used to build
# the GitHub OAuth callback/redirect URLs and the Athena sign-in "next" URL.
# AUTH_URL="https://your-domain.com"

# Base URL of the Athena hub that owns identity (shared `tv` SSO cookie and
# GET /api/me). Defaults to https://athena.org.tr; override for local testing
# against a different Athena instance.
# ATHENA_BASE_URL="https://athena.org.tr"
