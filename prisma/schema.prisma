generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- Identity ---
//
// Calytrix has no accounts or sessions of its own. Identity comes from Athena's
// shared SSO cookie (`tv`, validated against https://athena.org.tr/api/me — see
// src/lib/session.ts). This table only stores what Calytrix needs beyond that:
// the optional GitHub authorization a user grants for repo/PR access.

model User {
  id                Int       @id // Athena account id (not a generated cuid)
  athenaUsername    String
  githubLogin       String?
  githubUserId      BigInt?
  githubAccessToken String?   @db.Text
  githubTokenScope  String?
  githubConnectedAt DateTime?

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --- Application models ---

model Repository {
  id        String   @id @default(cuid())
  githubId  BigInt   @unique
  fullName  String   @unique
  ownerLogin String
  name      String
  isPrivate Boolean  @default(false)

  pullRequests PullRequest[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PullRequest {
  id           String   @id @default(cuid())
  githubId     BigInt   @unique
  number       Int
  title        String
  authorLogin  String
  headSha      String
  baseSha      String
  headRef      String
  baseRef      String
  url          String

  repositoryId String
  repository   Repository @relation(fields: [repositoryId], references: [id], onDelete: Cascade)

  reviews Review[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([repositoryId, number])
}

enum ReviewStatus {
  PENDING
  COMPLETED
  FAILED
}

model Review {
  id            String       @id @default(cuid())
  headSha       String
  status        ReviewStatus @default(PENDING)
  errorMessage  String?
  summary       String?

  pullRequestId String
  pullRequest   PullRequest @relation(fields: [pullRequestId], references: [id], onDelete: Cascade)

  requestedById Int
  requestedBy   User @relation(fields: [requestedById], references: [id], onDelete: Cascade)

  findings Finding[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([pullRequestId, headSha])
}

enum Severity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum FindingCategory {
  BUG
  SECURITY
  PERFORMANCE
  CODE_QUALITY
  MISSING_TESTS
}

model Finding {
  id          String          @id @default(cuid())
  severity    Severity
  category    FindingCategory
  file        String
  line        Int?
  title       String
  description String          @db.Text
  why         String          @db.Text
  suggestion  String          @db.Text

  reviewId String
  review   Review @relation(fields: [reviewId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}
