# PostgreSQL connection string (Prisma)
DATABASE_URL="postgresql://user:password@localhost:5432/calytrix?schema=public"

# Auth.js — generate with: npx auth secret
AUTH_SECRET=""

# GitHub OAuth App credentials (github.com/settings/developers)
# Callback URL must be: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Anthropic API key (console.anthropic.com)
ANTHROPIC_API_KEY=""

# Required in production; the canonical URL of the deployed app
# AUTH_URL="https://your-domain.com"
